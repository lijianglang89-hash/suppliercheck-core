# ============================================================================
# 供应商智审 SupplierCheck · 环境变量示例
#
# 使用方式：复制本文件为 .env.local（本地开发）或 .env（部署时注入），
# 然后填入真实值。.env* 已被 .gitignore 排除，真实密钥不会进入 Git。
# ============================================================================

# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
NODE_ENV=development

# 站点对外可访问的根地址。用于 canonical / Open Graph / sitemap 的绝对 URL。
# 本地开发：http://localhost:3010
# 生产部署：填写正式域名，例如 https://suppliercheck.example.com
APP_URL=http://localhost:3010

# ---------------------------------------------------------------------------
# 数据库（标准 PostgreSQL，不绑定任何托管供应商）
# ---------------------------------------------------------------------------
# 本地开发示例（Docker Compose 起库时）：
#   postgresql://suppliercheck:suppliercheck@127.0.0.1:5432/suppliercheck
# 未来可替换为阿里云 RDS / Supabase 等，应用代码无需改动。
DATABASE_URL=postgresql://suppliercheck:CHANGE_ME@127.0.0.1:5432/suppliercheck

# ---------------------------------------------------------------------------
# 会话签名密钥
# ---------------------------------------------------------------------------
# 至少 32 个字符的随机串。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_至少32位随机字符串_请务必替换

# ---------------------------------------------------------------------------
# AI Provider
# ---------------------------------------------------------------------------
# V0.1 只实现 mock。接入真实模型时改为 openai-compatible，
# 该协议同时适用于阿里云百炼 / Qwen、OpenAI、DeepSeek、Kimi 等。
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ---------------------------------------------------------------------------
# 文件存储
# ---------------------------------------------------------------------------
# V0.1 只实现 local（私有磁盘目录，绝不位于 public/ 下）。
# 未来切换阿里云 OSS 时改为 oss 并补齐凭证。
STORAGE_PROVIDER=local
# 生产容器内固定为 /storage/uploads，宿主对应 /srv/suppliercheck/storage/uploads。
# data/ 目录留给 PostgreSQL 数据，两者不要混用。
STORAGE_PATH=./storage/uploads

# 单个上传文件大小上限（字节）。默认 20971520 = 20 MB。
# 实际生效值还会被 lib/documents/limits.ts 里的硬上限（50 MB）夹紧，
# 配置写大了也不会突破 —— 这是保护内存与磁盘的第二道闸门。
MAX_UPLOAD_BYTES=20971520

# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# ============================================================================
# 以下为未来阶段预留，本阶段不配置、不读取
# ============================================================================
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_V3_KEY=
