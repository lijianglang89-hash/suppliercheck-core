# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ---------------------------------------------------------------
# 环境变量：真实 secrets 绝不入库
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# 供应商资料是核心资产，本地私有存储目录绝不入库
# ---------------------------------------------------------------
/data/
/storage/

# 数据库本地文件（若未来改用嵌入式方案）
*.sqlite
*.sqlite3
*.db
pgdata/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent scratch
/tmp/

# WorkBuddy 本地项目数据（工作日志、会话摘要等），不入库
/.workbuddy/

# 截图验收产物（DESIGN.md §10）
docs/screenshots/

# 搜索引擎站长平台的登录态（含 Cookie，等同于账号凭据）
# 由 scripts/seo/search-console.mjs 生成，绝不能入库
.workbuddy/seo-profile/
*-state.json
suppliercheck-review-pack-*.zip
